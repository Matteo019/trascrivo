# Copia in .env e compila. Il file .env non va mai su git.

# --- Database ---------------------------------------------------------------
# password del Postgres interno allo stack: generane una lunga solo con lettere e numeri, es. `openssl rand -hex 32`
# (niente base64: i caratteri / + = rompono l'indirizzo del database)
POSTGRES_PASSWORD=
# fuori da Docker (sviluppo) serve l'indirizzo completo; nel compose lo costruisce da solo
# DATABASE_URL=postgresql://trascrivo:PASSWORD@localhost:5432/trascrivo

# --- Whisper ----------------------------------------------------------------
# small (veloce, ~1 GB RAM), medium (più preciso, ~2-3 GB), large-v3-turbo, large-v3 (al limite con 8 GB)
WHISPER_MODELLO=small
# it, en oppure auto
WHISPER_LINGUA=it
# thread CPU per Whisper (vuoto = metà dei core logici, di solito i core fisici)
WHISPER_THREAD=
# 1 = veloce, 5 = un po' più preciso e ~2 volte più lento
WHISPER_BEAM=1
# alza il volume delle voci lontane dal microfono prima di trascrivere
AUDIO_NORMALIZZA=1

# --- Limiti predefiniti per utente (l'admin può cambiarli per singolo utente) --
# Cloudflare Tunnel (piano gratuito) non accetta upload sopra i 100 MB
LIMITE_MB=100
LIMITE_MINUTI=180
LIMITE_JOB_GIORNO=20

# --- Conservazione ------------------------------------------------------------
# giorni dopo i quali il testo trascritto viene cancellato (l'audio si cancella subito)
CONSERVAZIONE_GIORNI=7

# --- Web ----------------------------------------------------------------------
# 1 in produzione (HTTPS dal tunnel). 0 solo per provare in locale su http://
COOKIE_SICURO=1
SESSIONE_ORE=168
# durata dei link di invito, in giorni
INVITO_GIORNI=7
# 1 = dietro Cloudflare Tunnel: l'IP vero del visitatore (per il limite ai tentativi di accesso) arriva
# nell'intestazione CF-Connecting-IP, accettata solo se la richiesta viene dalla rete Docker interna
IP_DA_CLOUDFLARE=1

# --- Risorse del worker (docker-compose) ---------------------------------------
WORKER_RAM=4g
WORKER_CPU=3
